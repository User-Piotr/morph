# Every pinned third-party version, in one place. Bump here in a reviewed pull
# request; claude/tests/versions.sh (run in CI) fails until every copy matches.
#
# Read directly by claude/install.sh. JSON files cannot read it, so these keep a
# copy that the check compares:
#   CONTEXT7_MCP_VERSION           plugins/morph/.claude-plugin/plugin.json
#   AWS_DOCUMENTATION_MCP_VERSION  plugins/devops/.claude-plugin/plugin.json
#   CAVEMAN_REF                    claude/settings.json, extraKnownMarketplaces.caveman

HEADROOM_VERSION=0.42.0              # pypi.org/project/headroom-ai
GRAPHIFY_VERSION=0.9.102             # pypi.org/project/graphifyy
CONTEXT7_MCP_VERSION=4.5.0           # npmjs.com/package/@upstash/context7-mcp
AWS_DOCUMENTATION_MCP_VERSION=1.2.4  # pypi.org/project/awslabs.aws-documentation-mcp-server
CAVEMAN_REF=v4.0.1                   # github.com/JuliusBrussee/caveman/tags
